{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jake-wormhole:candidate-manifest:1.0",
  "title": "Wormhole fixed reference candidate manifest v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "format": "uuid",
      "pattern": "^(?:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$(?![\\s\\S])"
    },
    "source_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^(?:[0-9a-f]{40})$(?![\\s\\S])"
    },
    "source_dirty": {
      "type": "boolean"
    },
    "mode": {
      "type": "string",
      "enum": [
        "fixture",
        "container-reference"
      ]
    },
    "operation": {
      "const": "synthetic-reference-candidate",
      "type": "string"
    },
    "synthetic": {
      "const": true,
      "type": "boolean"
    },
    "version": {
      "const": "1.0.0-reference",
      "type": "string"
    },
    "source_sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
    },
    "chunk_plan_sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
    },
    "chunk_manifest_sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
    },
    "applicability": {
      "type": "object",
      "properties": {
        "os_id": {
          "type": "string",
          "const": "ubuntu"
        },
        "os_version": {
          "type": "string",
          "const": "24.04"
        },
        "platform": {
          "type": "string",
          "const": "linux/amd64"
        }
      },
      "required": [
        "os_id",
        "os_version",
        "platform"
      ],
      "additionalProperties": false
    },
    "configuration": {
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "const": "wormhole-reference-v1"
        },
        "greeting": {
          "type": "string",
          "const": "reference-ready"
        }
      },
      "required": [
        "format",
        "greeting"
      ],
      "additionalProperties": false
    },
    "files": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "x-uniqueBy": [
        "path"
      ],
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "enum": [
              "source.synthetic.bin",
              "payload.py",
              "version.txt",
              "config.json"
            ]
          },
          "sha256": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8388608
          }
        },
        "required": [
          "path",
          "sha256",
          "size"
        ],
        "additionalProperties": false
      }
    },
    "test_contract_sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
    },
    "production_iso_eligible": {
      "type": "boolean",
      "const": false
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "source_revision",
    "source_dirty",
    "mode",
    "operation",
    "synthetic",
    "version",
    "source_sha256",
    "chunk_plan_sha256",
    "chunk_manifest_sha256",
    "applicability",
    "configuration",
    "files",
    "test_contract_sha256",
    "production_iso_eligible"
  ],
  "additionalProperties": false
}
