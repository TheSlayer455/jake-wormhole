{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jake-wormhole:schema:assessment:1.0",
  "title": "Jake Wormhole assessment v1",
  "$comment": "Generated from wormhole/contracts.py. Fixed-contract validation also enforces x-uniqueBy and the declared size/depth bounds; schema validity alone is not runtime acceptance or release eligibility. Version 1 cannot declare a complete runtime pipeline or an eligible release.",
  "x-maxEncodedBytes": 1048576,
  "x-maxDepth": 16,
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "format": "uuid",
      "pattern": "^(?:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$(?![\\s\\S])"
    },
    "source_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^(?:[0-9a-f]{40})$(?![\\s\\S])"
    },
    "source_dirty": {
      "type": "boolean"
    },
    "mode": {
      "type": "string",
      "enum": [
        "fixture",
        "container-reference"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "error",
        "unsupported",
        "unverified"
      ]
    },
    "synthetic": {
      "type": "boolean",
      "const": true
    },
    "policy_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?:[a-z][a-z0-9._-]{0,127})$(?![\\s\\S])"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "finding_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^(?:[a-z][a-z0-9_-]{0,63})$(?![\\s\\S])"
          },
          "status": {
            "type": "string",
            "enum": [
              "Open",
              "Not a Finding",
              "Not Reviewed",
              "Not Applicable"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": [
          "finding_id",
          "status",
          "summary"
        ],
        "additionalProperties": false
      },
      "maxItems": 1000,
      "x-uniqueBy": [
        "finding_id"
      ],
      "$comment": "Wormhole also rejects duplicate identities named by x-uniqueBy."
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "source_revision",
    "source_dirty",
    "mode",
    "status",
    "synthetic",
    "policy_id",
    "findings"
  ],
  "additionalProperties": false
}
