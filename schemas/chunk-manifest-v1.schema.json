{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jake-wormhole:schema:chunk-manifest:1.0",
  "title": "Wormhole synthetic chunk manifest v1",
  "$comment": "Generated by wormhole.chunks.schema(). Runtime additionally requires contiguous ordered indices/offsets, exact chunk names/sizes, and a separately bound manifest digest. Hashes establish consistency, not origin authenticity.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "format": "uuid",
      "pattern": "^(?:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$(?![\\s\\S])"
    },
    "source_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^(?:[0-9a-f]{40})$(?![\\s\\S])"
    },
    "source_dirty": {
      "type": "boolean"
    },
    "mode": {
      "type": "string",
      "enum": [
        "fixture",
        "container-reference"
      ]
    },
    "operation": {
      "type": "string",
      "const": "synthetic-chunks"
    },
    "synthetic": {
      "type": "boolean",
      "const": true
    },
    "input_name": {
      "type": "string",
      "const": "source.synthetic.bin"
    },
    "total_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8388608
    },
    "whole_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$(?![\\s\\S])",
      "minLength": 64,
      "maxLength": 64
    },
    "chunk_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1048576
    },
    "chunks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "x-uniqueBy": [
        "index"
      ],
      "items": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 8388607
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1048576
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$(?![\\s\\S])",
            "minLength": 64,
            "maxLength": 64
          },
          "name": {
            "type": "string",
            "minLength": 16,
            "maxLength": 16,
            "pattern": "^chunk-[0-9]{6}\\.bin$(?![\\s\\S])"
          }
        },
        "required": [
          "index",
          "offset",
          "size",
          "sha256",
          "name"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "source_revision",
    "source_dirty",
    "mode",
    "operation",
    "synthetic",
    "input_name",
    "total_size",
    "whole_sha256",
    "chunk_size",
    "chunks"
  ],
  "additionalProperties": false
}
