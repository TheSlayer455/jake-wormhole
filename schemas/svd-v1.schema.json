{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jake-wormhole:schema:svd:1.0",
  "title": "Jake Wormhole svd v1",
  "$comment": "Generated from wormhole/contracts.py. Fixed-contract validation also enforces x-uniqueBy and the declared size/depth bounds; schema validity alone is not runtime acceptance or release eligibility. Version 1 cannot declare a complete runtime pipeline or an eligible release.",
  "x-maxEncodedBytes": 1048576,
  "x-maxDepth": 16,
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "format": "uuid",
      "pattern": "^(?:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$(?![\\s\\S])"
    },
    "source_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^(?:[0-9a-f]{40})$(?![\\s\\S])"
    },
    "source_dirty": {
      "type": "boolean"
    },
    "mode": {
      "type": "string",
      "enum": [
        "fixture",
        "container-reference"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "error",
        "unsupported",
        "unverified"
      ]
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "target_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^(?:[a-z][a-z0-9_-]{0,63})$(?![\\s\\S])"
          },
          "os_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^(?:[a-z][a-z0-9_-]{0,63})$(?![\\s\\S])"
          },
          "os_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "packages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240
                },
                "version": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240
                }
              },
              "required": [
                "name",
                "version"
              ],
              "additionalProperties": false
            },
            "maxItems": 4096,
            "uniqueItems": true
          },
          "payload_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "image_digest": {
            "type": "string",
            "minLength": 1,
            "maxLength": 71,
            "pattern": "^(?:sha256:[0-9a-f]{64})$(?![\\s\\S])"
          },
          "candidate_sha256": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^(?:[0-9a-f]{64})$(?![\\s\\S])"
          },
          "collector_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "target_id",
          "os_id",
          "os_version",
          "packages",
          "payload_version",
          "image_digest",
          "candidate_sha256",
          "collector_version"
        ],
        "additionalProperties": false
      },
      "maxItems": 100,
      "x-uniqueBy": [
        "target_id"
      ],
      "$comment": "Wormhole also rejects duplicate identities named by x-uniqueBy."
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "source_revision",
    "source_dirty",
    "mode",
    "status",
    "targets"
  ],
  "additionalProperties": false
}
