{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jake-wormhole:schema:inventory:1.0",
  "title": "Jake Wormhole inventory v1",
  "$comment": "Generated from wormhole/contracts.py. Fixed-contract validation also enforces x-uniqueBy and the declared size/depth bounds; schema validity alone is not runtime acceptance or release eligibility. Version 1 cannot declare a complete runtime pipeline or an eligible release.",
  "x-maxEncodedBytes": 1048576,
  "x-maxDepth": 16,
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "format": "uuid",
      "pattern": "^(?:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$(?![\\s\\S])"
    },
    "source_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^(?:[0-9a-f]{40})$(?![\\s\\S])"
    },
    "source_dirty": {
      "type": "boolean"
    },
    "mode": {
      "type": "string",
      "enum": [
        "fixture",
        "container-reference"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "error",
        "unsupported",
        "unverified"
      ]
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "target_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^(?:[a-z][a-z0-9_-]{0,63})$(?![\\s\\S])"
          },
          "resource_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9_.:-]{0,127})$(?![\\s\\S])"
          },
          "host": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "pattern": "^(?:[A-Za-z0-9:][A-Za-z0-9.:-]{0,252})$(?![\\s\\S])",
            "format": "host"
          },
          "ssh_port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "ssh_user": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "^(?:[a-z_][a-z0-9_-]{0,31})$(?![\\s\\S])"
          },
          "image_digest": {
            "type": "string",
            "minLength": 1,
            "maxLength": 71,
            "pattern": "^(?:sha256:[0-9a-f]{64})$(?![\\s\\S])"
          },
          "status": {
            "type": "string",
            "enum": [
              "unverified",
              "created",
              "started",
              "tcp-ready",
              "ssh-ready",
              "ansible-ready",
              "failed"
            ]
          }
        },
        "required": [
          "target_id",
          "resource_id",
          "host",
          "ssh_port",
          "ssh_user",
          "image_digest",
          "status"
        ],
        "additionalProperties": false
      },
      "maxItems": 100,
      "x-uniqueBy": [
        "target_id"
      ],
      "$comment": "Wormhole also rejects duplicate identities named by x-uniqueBy."
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "source_revision",
    "source_dirty",
    "mode",
    "status",
    "targets"
  ],
  "additionalProperties": false
}
