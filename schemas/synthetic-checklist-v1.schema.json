{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jake-wormhole:synthetic-checklist:1.0",
  "title": "Original Wormhole synthetic checklist",
  "$comment": "Not CKL or a real scanner format. The component also enforces exact predeclared IDs, uniqueness, control-text and byte bounds; parsing is separate from reference policy and release eligibility.",
  "x-maxEncodedBytes": 65536,
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schema_version", "synthetic", "findings"],
  "properties": {
    "format": {"const": "wormhole.synthetic-checklist"},
    "schema_version": {"const": "1.0"},
    "synthetic": {"const": true},
    "findings": {
      "type": "array", "minItems": 1, "maxItems": 128,
      "x-uniqueBy": ["finding_id"],
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["finding_id", "status", "summary", "reason"],
        "properties": {
          "finding_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$(?![\\s\\S])"},
          "status": {"enum": ["Open", "Not a Finding", "Not Reviewed", "Not Applicable"]},
          "summary": {"type": "string", "minLength": 1, "maxLength": 1000},
          "reason": {"type": "string", "maxLength": 1000}
        }
      }
    }
  }
}
